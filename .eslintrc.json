{
  "extends": ["airbnb", "prettier", "plugin:node/recommended"],
  "plugins": ["prettier"],
  "settings": {
    "node": {
      "version": "current"
    }
  },
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "prettier/prettier": [
      "error",
      {
        "endOfLine": "auto"
      }
    ],
    "spaced-comment": "off",
    "arrow-body-style": "off",
    "no-console": "off",
    "consistent-return": "off",
    "func-names": "off",
    "object-shorthand": "off",
    "no-process-exit": "off",
    "no-param-reassign": "off",
    "no-return-await": "off",
    "no-underscore-dangle": "off",
    "class-methods-use-this": "off",
    "no-plusplus": "off",
    "no-await-in-loop": "off",

    "prefer-destructuring": [
      "error",
      {
        "object": true,
        "array": false
      }
    ],

    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "req|res|next|val|err"
      }
    ]
  }
}